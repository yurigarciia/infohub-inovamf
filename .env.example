# ---------------------------------------------------------------------------
# InfoHub -> InovAMF — configuração ÚNICA (raiz do repo).
#   cp .env.example .env   e ajuste o que precisar.
#
# Lido por: server (server/src/config/env.ts) e Next (app/next.config.ts).
# No deploy (Coolify) as variáveis são injetadas pela plataforma — este
# arquivo é só a referência do que precisa existir.
# ---------------------------------------------------------------------------

# --- Processos / portas ---
# Local: development. No Coolify/produção: production (o build e o entrypoint forçam,
# mas defina mesmo assim — NÃO copie "development" para o deploy).
NODE_ENV=development
# Porta do front (Next). No Coolify a plataforma injeta PORT.
PORT=3000
# Porta INTERNA da API (não exposta no deploy single-service). O Next
# reescreve /api/* para http://127.0.0.1:$API_PORT.
API_PORT=3333

# --- Banco ---
# Qualquer PostgreSQL acessível: local, container próprio ou gerenciado
# (Neon/Supabase/RDS — nesses, normalmente com ?sslmode=require no fim).
DATABASE_URL=postgresql://infohub:infohub@localhost:5432/infohub
# Schema onde ficam as tabelas do app (o pool fixa o search_path nele). Num
# banco COMPARTILHADO use o SEU schema — o bootstrap/db:migrate criam se faltar.
# db:reset/db:seed recusam o "public" e schemas que não sejam deste app.
DB_SCHEMA=infohub

# --- Auth ---
JWT_ACCESS_SECRET=dev-troque-este-segredo-access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10
# Flag Secure do cookie de refresh (default: true em produção). Coloque false
# SÓ se o app for servido em http:// puro — senão o browser descarta o cookie.
# COOKIE_SECURE=false
# path do cookie de refresh. "/" cobre acesso direto e via proxy (/api/auth/...)
REFRESH_COOKIE_PATH=/

# --- URLs ---
# URL pública do app — base dos links enviados por e-mail (/definir-senha?token=...)
APP_URL=http://localhost:3000
# Só usada em acesso cross-origin à API (dev sem o proxy do Next).
CORS_ORIGIN=http://localhost:3000
# Override do alvo do proxy /api/* (default: http://127.0.0.1:$API_PORT).
# INTERNAL_API_URL=http://127.0.0.1:3333
# Override para o front bater DIRETO na API (sem passar pelo proxy /api).
# NEXT_PUBLIC_API_URL=http://localhost:3333

# --- E-mail (opcional) ---
# mail-service próprio (POST /emails, header x-api-key). Sem MAIL_API_KEY os
# e-mails só são LOGADOS no console (e gravados em email_notifications).
# MAIL_API_URL=https://mail-service.southinovations.com.br
# MAIL_API_KEY=
# Contas de DEMONSTRAÇÃO (seed) NÃO recebem e-mail real — só log. Domínios
# separados por vírgula; deixe vazio ("") para desligar a trava.
# MAIL_SKIP_DOMAINS=acad.amf.br,infohub.amf.br

# --- Uploads (RNF-04) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# --- 1º administrador (criado no bootstrap se ainda não existir nenhum ADMIN) ---
# Sem isso (e sem SEED_ON_INIT) o app sobe mas ninguém consegue entrar.
# ADMIN_EMAIL=voce@exemplo.com
# ADMIN_PASSWORD=troque-esta-senha   # mín. 8 caracteres
# ADMIN_NAME=Administrador

# --- Seed automático no 1º boot do deploy (opcional) ---
# true = popula o dataset de demo quando o banco está vazio (contas senha123).
SEED_ON_INIT=
