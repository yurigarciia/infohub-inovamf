# Copie para app/.env.local

# Por padrão o front chama a API por "/api" (mesma origem) e o Next
# reescreve para a API local — ver app/next.config.ts. Nesse modo você
# NÃO precisa definir NEXT_PUBLIC_API_URL.
#
# Defina só se quiser bater direto na API (ex.: dev sem passar pelo proxy):
# NEXT_PUBLIC_API_URL=http://localhost:3333

# Alvo do proxy /api/* dentro do container/host (deve casar com API_PORT
# do server/.env). Só mude se a API não estiver em 127.0.0.1:3333.
# INTERNAL_API_URL=http://127.0.0.1:3333
