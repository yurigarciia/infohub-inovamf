# Copie para server/.env e ajuste conforme necessário.

# --- Servidor ---
PORT=3333
NODE_ENV=development
# origem do front (Next.js) permitida no CORS
CORS_ORIGIN=http://localhost:3000

# --- Banco (bate com docker-compose.yml na raiz) ---
DATABASE_URL=postgresql://infohub:infohub@localhost:5432/infohub

# --- Auth ---
# segredo para assinar o access token (JWT). Troque em qualquer ambiente real.
JWT_ACCESS_SECRET=dev-troque-este-segredo-access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# custo do bcrypt
BCRYPT_ROUNDS=10

# --- E-mail (opcional nesta fase) ---
# sem chave = usa o ConsoleEmailSender (loga + grava email_notifications)
RESEND_API_KEY=
EMAIL_FROM=InfoHub <no-reply@infohub.local>

# --- Uploads (RNF-04) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
