# Copie para server/.env e ajuste conforme necessário.

# --- Servidor ---
# Porta INTERNA da API. Fica separada de PORT (que é a do Next). No deploy
# single-service o Next expõe PORT e reescreve /api/* para esta.
API_PORT=3333
NODE_ENV=development
# origem do front no CORS — só usada quando o front chama a API cross-origin
# (dev sem o proxy do Next). Com o proxy, as chamadas são same-origin.
CORS_ORIGIN=http://localhost:3000
# URL pública do app (a do front) — base dos links enviados por e-mail
# (ex.: <APP_URL>/definir-senha?token=...)
APP_URL=http://localhost:3000
# path do cookie de refresh. "/" cobre acesso direto e via proxy (/api/auth/...)
REFRESH_COOKIE_PATH=/

# --- Banco ---
# Aponte para QUALQUER PostgreSQL acessível: instalação local, um container
# que você suba por conta própria, ou um serviço gerenciado (Neon, Supabase,
# RDS...). db:migrate/db:reset aplicam db/schema.sql nesse banco.
# Ex. local:      postgresql://usuario:senha@localhost:5432/infohub
# Ex. gerenciado: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://infohub:infohub@localhost:5432/infohub

# --- Auth ---
# segredo para assinar o access token (JWT). Troque em qualquer ambiente real.
JWT_ACCESS_SECRET=dev-troque-este-segredo-access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# custo do bcrypt
BCRYPT_ROUNDS=10

# --- E-mail (opcional nesta fase) ---
# sem chave = usa o ConsoleEmailSender (loga + grava email_notifications)
RESEND_API_KEY=
EMAIL_FROM=InfoHub <no-reply@infohub.local>

# --- Uploads (RNF-04) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
