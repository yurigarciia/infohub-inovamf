{
  "name": "infohub-inovamf-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend do InfoHub -> InovAMF: Express + TypeScript + PostgreSQL (pg, SQL puro, sem ORM). Ver PLAN.md e decisoes.md.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/db/bootstrap.js && node dist/index.js",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/migrate.ts --reset",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
